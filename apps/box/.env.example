# Projet Supabase « hgwf-box » (eu-west-3, Paris).
# La cle publiable est faite pour etre exposee au navigateur : ce sont les
# politiques RLS de la base qui protegent les donnees, pas le secret de la cle.
NEXT_PUBLIC_SUPABASE_URL=https://mgzuujkhjjdypgutgoss.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Assistance de saisie (Gemini). Sans elle l application fonctionne :
# seul l encart « Decrire le parc en une phrase » disparait.
GEMINI_API_KEY=

# Relance des loyers en retard. Meme expediteur que le fret :
# contact@hgwf-cargo.fr, deja authentifie SPF et DKIM.
RESEND_API_KEY=
EMAIL_EXPEDITEUR=
EMAIL_INTERNE=

# Route /api/relances, pour une tache planifiee une fois l'application
# deployee. Sans ces deux valeurs la route refuse tout.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
