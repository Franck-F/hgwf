NEXT_PUBLIC_SANITY_PROJECT_ID=remplacer_par_projectId
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# ── Préversion SSR (aperçu visuel du Studio) — à définir sur Vercel ──────────
# Active le mode préversion : brouillons + stega + édition visuelle.
# NE PAS définir sur le build de production statique (Netlify/OVH).
NEXT_PUBLIC_SITE_MODE=preview
# URL du Studio (pour le lien cliquer-pour-éditer).
NEXT_PUBLIC_SANITY_STUDIO_URL=https://hgwf-cargo.sanity.studio
# Jeton "Viewer" (sanity.io/manage → API → Tokens, rôle Viewer) pour lire les
# brouillons. SERVEUR UNIQUEMENT (pas de préfixe NEXT_PUBLIC_).
SANITY_VIEWER_TOKEN=
# URL de l'API HGWF déployée (apps/api) — formulaires + suivi réel.
# Vide = les formulaires ouvrent le client mail et le suivi reste en démo.
NEXT_PUBLIC_HGWF_API_URL=
