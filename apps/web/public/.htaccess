# Redirections SEO (hébergement OVH, Apache).
RewriteEngine On

# Forcer HTTPS.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://hgwf-cargo.fr%{REQUEST_URI} [R=301,L]

# www -> apex (une seule URL canonique).
RewriteCond %{HTTP_HOST} ^www\.hgwf-cargo\.fr$ [NC]
RewriteRule ^ https://hgwf-cargo.fr%{REQUEST_URI} [R=301,L]

# Racine -> locale par défaut (le meta refresh de index.html reste en secours).
# Cible absolue : en relatif, Apache ajoute un « :443 » parasite à l'URL.
RewriteRule ^$ https://hgwf-cargo.fr/fr/ [R=301,L]

# ── En-têtes de sécurité ──────────────────────────────────────────────────────
# Le site est un export statique sans script tiers : ces en-têtes ne coûtent
# rien et ferment des portes ouvertes par défaut.
<IfModule mod_headers.c>
  # HTTPS obligatoire pendant un an, y compris sur les sous-domaines.
  # Posé après la redirection ci-dessus, qui garantit déjà le HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Interdit l'affichage du site dans un cadre chez un tiers (clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"
  # Empêche le navigateur de deviner un type de contenu autre que celui déclaré.
  Header always set X-Content-Type-Options "nosniff"
  # Ne transmet l'URL complète qu'aux pages du même site.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Aucune de ces fonctions n'est utilisée : on les refuse explicitement.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

# ── Cache navigateur ──────────────────────────────────────────────────────────
# Par défaut OVH ne sert que 15 min de cache : chaque visite retéléchargeait
# scripts, polices et images.
<IfModule mod_headers.c>
  # Fichiers de build Next.js : leur nom contient une empreinte du contenu, un
  # nouveau déploiement produit de nouveaux noms. Cache d'un an, sans revalidation.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Photos, logos, icônes : noms stables, remplacés rarement. Un mois.
  <ElseIf "%{REQUEST_URI} =~ m#\.(jpe?g|png|webp|avif|svg|ico|woff2?)$#">
    Header set Cache-Control "public, max-age=2592000"
  </ElseIf>
  # Pages HTML et données : toujours revalider, pour qu'une publication Sanity
  # soit visible immédiatement.
  <ElseIf "%{REQUEST_URI} =~ m#(/|\.html|\.txt|\.xml)$#">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </ElseIf>
</IfModule>

