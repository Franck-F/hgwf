# Projet Sanity
SANITY_PROJECT_ID=b5xsqdjy
# Dataset PRIVÉ des données du back-office
SANITY_DATASET=operations
# Jeton avec droits d'écriture (sanity.io/manage → API → Tokens → rôle Editor)
SANITY_API_WRITE_TOKEN=
# Origines autorisées (CORS), séparées par des virgules
ALLOWED_ORIGINS=http://localhost:3000,https://www.hgwf-cargo.fr
# Port d'écoute
PORT=8787

# ── Envoi d'e-mails transactionnels (Resend) ──────────────────────────────────
# Clé d'API. Une clé restreinte à l'envoi suffit et vaut mieux : elle ne peut
# ni lire ni modifier la configuration du compte.
RESEND_API_KEY=
# Expéditeur des messages aux clients, au format « Nom <adresse> ».
# L'adresse DOIT appartenir à un domaine vérifié chez Resend, sinon l'envoi est
# refusé. Tant que ce champ est vide, aucun e-mail n'est envoyé : c'est
# l'interrupteur qui permet de déployer le code avant la vérification du
# domaine.
EMAIL_EXPEDITEUR=
# Adresse de l'équipe : reçoit l'alerte à chaque nouvelle demande, et sert
# d'adresse de réponse sur les messages envoyés aux clients.
EMAIL_INTERNE=contact@hgwf-cargo.fr
